#!/usr/bin/env bash
set -euo pipefail

name=${1:?name required}
repo=${2:?owner/repository required}
asset_regex=${3:?asset regex required}
kind=${4:?rpm, archive, archive-auto, or font required}
api="https://api.github.com/repos/$repo/releases?per_page=20"
cache_root="/var/cache/xps-upstream/$name"
state_root="/var/lib/xps-upstream/$name"
install_root="/opt/xps-apps/$name"

headers=(-H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28')
if [[ -n ${GH_TOKEN:-} ]]; then
  headers+=(-H "Authorization: Bearer $GH_TOKEN")
fi

tmp_json=$(mktemp)
cleanup() { rm -f "$tmp_json"; }
trap cleanup EXIT

if ! curl --fail --silent --show-error --location "${headers[@]}" "$api" -o "$tmp_json"; then
  echo "Unable to resolve $repo. Set GH_TOKEN if the anonymous GitHub API limit was reached." >&2
  exit 1
fi

release=$(jq -er --arg re "$asset_regex" '
  first(
    .[]
    | select(.draft == false and .prerelease == false)
    | . as $release
    | first(.assets[] | select(.name | test($re)))
    | {tag:$release.tag_name,name:.name,url:.browser_download_url,digest:(.digest // "")}
  )
' "$tmp_json") || {
  echo "No stable $repo asset matches $asset_regex" >&2
  exit 1
}

tag=$(jq -r .tag <<<"$release")
asset=$(jq -r .name <<<"$release")
url=$(jq -r .url <<<"$release")
digest=$(jq -r .digest <<<"$release")
safe_tag=$(printf '%s' "$tag" | tr -c 'A-Za-z0-9._+-' _)
mkdir -p "$cache_root/$safe_tag" "$state_root"
download="$cache_root/$safe_tag/$asset"

if [[ $kind == font ]]; then
  install_root="/usr/local/share/fonts/$name"
fi

if [[ ( $kind == rpm || ( $kind == archive-auto && $asset == *.rpm ) ) ]] \
  && [[ -r $state_root/version ]] \
  && [[ $(<"$state_root/version") == "$tag" ]] && rpm -q "$name" >/dev/null 2>&1; then
  echo "UNCHANGED: $name $tag"
  exit 0
fi
if [[ $kind != rpm && -L $install_root/current ]] \
  && [[ $(basename "$(readlink -f "$install_root/current")") == "$safe_tag" ]]; then
  echo "UNCHANGED: $name $tag"
  exit 0
fi

if [[ ! -f $download ]]; then
  partial="$download.partial"
  curl --fail --location --retry 3 --output "$partial" "$url"
  mv -f "$partial" "$download"
fi

expected=${digest#sha256:}
if [[ -z $expected || $expected == "$digest" ]]; then
  checksum_url=$(jq -r --arg tag "$tag" '
    first(
      .[] | select(.tag_name == $tag) | .assets[]
      | select(.name | test("^(SHA-256[.]txt|SHA256SUMS([.]txt)?|checksums([.]txt)?)$"; "i"))
      | .browser_download_url
    ) // empty
  ' "$tmp_json")
  [[ -n $checksum_url ]] || {
    echo "Refusing unverified asset $asset: no GitHub digest or release checksum file" >&2
    exit 1
  }
  sums="$cache_root/$safe_tag/checksums.txt"
  curl --fail --silent --show-error --location "$checksum_url" -o "$sums"
  expected=$(awk -v file="$asset" '$0 ~ ("[ */]" file "$") {print $1; exit}' "$sums")
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]] || {
    echo "No SHA-256 entry for $asset in release checksum file" >&2
    exit 1
  }
fi

actual=$(sha256sum "$download" | awk '{print $1}')
[[ $actual == "$expected" ]] || {
  echo "SHA-256 mismatch for $asset" >&2
  exit 1
}

if [[ $kind == rpm || ( $kind == archive-auto && $asset == *.rpm ) ]]; then
  rpmkeys --checksig "$download" || true
  dnf -y --nogpgcheck install "$download"
  printf '%s\n' "$tag" > "$state_root/version.tmp"
  mv -f "$state_root/version.tmp" "$state_root/version"
  restorecon -RF /usr/bin /usr/lib /usr/lib64 /usr/share/applications 2>/dev/null || true
  echo "CHANGED: installed $name $tag"
  exit 0
fi

if [[ $kind == binary ]]; then
  version_dir="$install_root/versions/$safe_tag"
  mkdir -p "$version_dir/bin"
  install -m 0755 "$download" "$version_dir/bin/$name.new"
  mv -f "$version_dir/bin/$name.new" "$version_dir/bin/$name"
  ln -sfn "versions/$safe_tag" "$install_root/current.new"
  mv -Tf "$install_root/current.new" "$install_root/current"
  ln -sfn "$install_root/current/bin/$name" "/usr/local/bin/$name"
  restorecon -RF "$install_root" /usr/local/bin 2>/dev/null || true
  echo "CHANGED: installed $name $tag"
  exit 0
fi

mkdir -p "$install_root"
version_dir="$install_root/versions/$safe_tag"
stage=$(mktemp -d "$install_root/.stage.XXXXXX")
trap 'rm -rf "$stage"; cleanup' EXIT
mkdir -p "$stage/payload"
case "$asset" in
  *.tar.gz|*.tgz) tar -xzf "$download" -C "$stage/payload" ;;
  *.tar.xz) tar -xJf "$download" -C "$stage/payload" ;;
  *.zip) unzip -q "$download" -d "$stage/payload" ;;
  *) echo "Unsupported archive: $asset" >&2; exit 1 ;;
esac

if [[ $kind != font ]]; then
  mkdir -p "$stage/payload/bin"
  case "$name" in
    walker) candidates=(walker) ;;
    localsend) candidates=(localsend) ;;
    lazygit) candidates=(lazygit) ;;
    lazydocker) candidates=(lazydocker) ;;
    mdview) candidates=(mdview) ;;
    bun) candidates=(bun) ;;
    balena) candidates=(balena) ;;
    *) candidates=("$name") ;;
  esac
  for binary in "${candidates[@]}"; do
    search_name=$binary
    [[ $name != localsend ]] || search_name=localsend_app
    found=$(find "$stage/payload" -type f -name "$search_name" -perm /111 -not -path '*/bin/*' -print -quit)
    if [[ -z $found ]]; then
      found=$(find "$stage/payload" -type f -name "$search_name" -print -quit)
    fi
    [[ -n $found ]] || { echo "Archive contains no $binary executable" >&2; exit 1; }
    chmod 0755 "$found"
    if [[ $found != "$stage/payload/bin/$binary" ]]; then
      relative=$(realpath --relative-to="$stage/payload/bin" "$found")
      ln -s "$relative" "$stage/payload/bin/$binary"
    fi
  done
fi

mkdir -p "$install_root/versions"
rm -rf "$version_dir.new"
mv "$stage/payload" "$version_dir.new"
rm -rf "$version_dir"
mv "$version_dir.new" "$version_dir"
ln -sfn "versions/$safe_tag" "$install_root/current.new"
mv -Tf "$install_root/current.new" "$install_root/current"

if [[ $kind != font ]]; then
  for binary in "${candidates[@]}"; do
    ln -sfn "$install_root/current/bin/$binary" "/usr/local/bin/$binary"
  done
fi
restorecon -RF "$install_root" /usr/local/bin 2>/dev/null || true
echo "CHANGED: installed $name $tag"
