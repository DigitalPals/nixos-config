#!/usr/bin/env bash
set -euo pipefail
install_dir="${XDG_DATA_HOME:-$HOME/.local/share}/t3code-nightly"
appimage="$install_dir/T3-Code-Nightly-x86_64.AppImage"
headers=(-H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28')
[[ -z ${GH_TOKEN:-} ]] || headers+=(-H "Authorization: Bearer $GH_TOKEN")
json=$(mktemp)
tmp=""
trap 'rm -f "$json" "$tmp"' EXIT
curl --fail --silent --show-error --location "${headers[@]}" \
  'https://api.github.com/repos/pingdotgg/t3code/releases?per_page=30' -o "$json"
release=$(jq -ec 'first(.[] | select(.prerelease and (.tag_name | contains("-nightly."))) as $r | $r.assets[] | select(.name | endswith("-x86_64.AppImage")) | {tag:$r.tag_name,url:.browser_download_url,digest:.digest})' "$json")
tag=$(jq -r .tag <<<"$release")
url=$(jq -r .url <<<"$release")
expected=$(jq -r .digest <<<"$release")
expected=${expected#sha256:}
[[ $expected =~ ^[[:xdigit:]]{64}$ ]] || { echo "T3Code nightly asset has no GitHub digest" >&2; exit 1; }
if [[ -x $appimage && -r $install_dir/version && $(<"$install_dir/version") == "$tag" ]]; then
  echo "UNCHANGED: T3Code $tag"
  exit 0
fi
mkdir -p "$install_dir"
tmp=$(mktemp "$install_dir/.T3-Code.XXXXXX")
curl --fail --location --retry 3 --output "$tmp" "$url"
actual=$(sha256sum "$tmp" | awk '{print $1}')
[[ $actual == "$expected" ]] || { echo "T3Code digest mismatch" >&2; exit 1; }
chmod 0755 "$tmp"
mv -f "$tmp" "$appimage"
tmp=""
printf '%s\n' "$tag" > "$install_dir/version"
echo "CHANGED: T3Code $tag"
