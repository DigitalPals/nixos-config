#!/usr/bin/env bash
# paste-image: Save clipboard image to temp file and type path into focused window
# Uses wtype to type the path, so it works in any application

# Check if clipboard has image data
if ! wl-paste --list-types 2>/dev/null | grep -q "image/"; then
    # No image - notify user
    notify-send "Paste Image" "No image in clipboard" -t 2000
    exit 0
fi

# Create temp file with timestamp
TMPFILE="/tmp/clipboard-image-$(date +%Y%m%d-%H%M%S)-$$.png"

# Save image to file
if wl-paste --type image/png > "$TMPFILE" 2>/dev/null; then
    # Type the file path into focused window
    wtype "$TMPFILE"
else
    notify-send "Paste Image" "Failed to save image" -t 2000
    exit 1
fi
