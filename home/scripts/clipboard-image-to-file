#!/usr/bin/env bash
set -euo pipefail

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard-images"
mkdir -p "$cache_dir"

mime="$(wl-paste --list-types | grep -E '^image/' | head -n 1 || true)"
if [[ -z "$mime" ]]; then
  echo "No image in clipboard." >&2
  exit 1
fi

case "$mime" in
  image/png) ext="png" ;;
  image/jpeg) ext="jpg" ;;
  image/webp) ext="webp" ;;
  image/gif) ext="gif" ;;
  image/bmp) ext="bmp" ;;
  image/tiff) ext="tiff" ;;
  *) ext="bin" ;;
esac

ts="$(date +%Y%m%d-%H%M%S)"
outfile="${cache_dir}/clipboard-${ts}.${ext}"

wl-paste --type "$mime" --no-newline > "$outfile"

printf 'file://%s\n' "$outfile" | wl-copy --type text/uri-list
echo "Copied file URL to clipboard: $outfile"
