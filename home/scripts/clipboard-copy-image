#!/usr/bin/env bash
# Copy image from stdin to clipboard, then convert to file path for CLI tools
set -euo pipefail

# Copy image to clipboard (reads from stdin)
wl-copy

# Convert to file path for Claude Code / Codex CLI
if [ -x "$HOME/.local/bin/clipboard-image-to-file" ]; then
  "$HOME/.local/bin/clipboard-image-to-file" >/dev/null 2>&1 || true
fi
