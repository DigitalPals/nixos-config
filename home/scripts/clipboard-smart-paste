#!/usr/bin/env bash
# Paste normally, except convert image-only clipboard contents to a file path for Kitty CLIs.
set -euo pipefail

paste_shortcut() {
  wtype -M shift -k Insert -m shift
}

types="$(wl-paste --list-types 2>/dev/null || true)"
image_mime="$(printf '%s\n' "$types" | grep -E '^image/' | head -n 1 || true)"
text_mime="$(printf '%s\n' "$types" | grep -E '^(text/plain|text/plain;charset=utf-8|UTF8_STRING|STRING)$' | head -n 1 || true)"
active_class="$(
  hyprctl activewindow -j 2>/dev/null \
    | jq -r '.class // ""' 2>/dev/null \
    | tr '[:upper:]' '[:lower:]' \
    || true
)"

case "$active_class" in
  kitty|kitty-*)
    if [[ -n "$image_mime" && -z "$text_mime" ]]; then
      exec "$HOME/.local/bin/clipboard-image-to-file"
    fi
    ;;
esac

paste_shortcut
