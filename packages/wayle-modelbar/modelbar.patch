+fn unavailable_notice(provider: &ProviderData) -> (String, String) {
+    let raw_error = provider
+        .error
+        .as_deref()
+        .unwrap_or("The provider did not return usage data.");
+
+    let normalized = raw_error.to_lowercase();
+    let needs_claude_auth = provider.provider == "claude"
+        && (normalized == "unauthorized"
+            || normalized.contains("no claude oauth credentials")
+            || normalized.contains("no claude access token")
+            || normalized.contains("run `claude` to authenticate"));
+    if needs_claude_auth {
+        return (
+            "Claude authorization required".to_owned(),
+            format!(
+                "Run `claude` in a terminal once, finish the Claude login/status prompts, then press Refresh. Details: {raw_error}"
+            ),
+        );
+    }
+
+    ("Usage unavailable".to_owned(), raw_error.to_owned())
+}
