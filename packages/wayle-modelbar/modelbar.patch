+fn build_credit_card(title: &str, value: &str, detail: &str) -> gtk::Box {
+    let card = gtk::Box::new(gtk::Orientation::Vertical, 12);
+    card.set_css_classes(&["mb-card"]);
+
+    let title_label = gtk::Label::new(None);
+    title_label.add_css_class("mb-card-title");
+    title_label.set_xalign(0.0);
+    title_label.set_markup(&format!(
+        "<span letter_spacing=\"1024\">{}</span>",
+        esc(&title.to_uppercase())
+    ));
+    card.append(&title_label);
+
+    let value_label = gtk::Label::new(None);
+    value_label.set_xalign(0.0);
+    value_label.set_markup(&format!(
+        "<span font=\"JetBrains Mono 21\" weight=\"600\" foreground=\"{TEXT}\">{}</span>",
+        esc(value)
+    ));
+    card.append(&value_label);
+
+    if !detail.is_empty() {
+        let detail_label = gtk::Label::new(None);
+        detail_label.add_css_class("mb-reset");
+        detail_label.set_xalign(0.0);
+        detail_label.set_wrap(true);
+        detail_label.set_markup(&format!(
+            "<span foreground=\"{FAINT}\">{}</span>",
+            esc(detail)
+        ));
+        card.append(&detail_label);
+    }
+    card
+}
