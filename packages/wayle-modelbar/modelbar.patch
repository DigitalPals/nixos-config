@@ -0,0 +1,27 @@
+use std::time::Duration;
+
+use relm4::ComponentSender;
+use wayle_config::ConfigProperty;
+
+use super::{ModelbarCmd, ModelbarModule};
+
+/// Polls on the configured interval, re-reading the property each cycle so
+/// settings changes apply without a restart.
+pub(super) fn spawn_watchers(
+    sender: &ComponentSender<ModelbarModule>,
+    refresh_interval_seconds: ConfigProperty<u32>,
+) {
+    sender.command(move |out, shutdown| {
+        shutdown
+            .register(async move {
+                loop {
+                    let secs = u64::from(refresh_interval_seconds.get().max(30));
+                    tokio::time::sleep(Duration::from_secs(secs)).await;
+                    if out.send(ModelbarCmd::Refresh).is_err() {
+                        break;
+                    }
+                }
+            })
+            .drop_on_shutdown()
+    });
+}
