+fn build_window_card(
+    provider: &ProviderData,
+    window: &WindowData,
+    spec: &ProviderSpec,
+    countdowns: &mut Vec<(gtk::Label, i64)>,
+) -> gtk::Box {
+    let pct = window.remaining();
+    let level = pct_level(pct);
+    let level_class = match level {
+        Level::Ok => None,
+        Level::Warn => Some("warn"),
+        Level::Danger => Some("danger"),
+    };
+
+    let card = gtk::Box::new(gtk::Orientation::Vertical, 12);
+    card.set_css_classes(&["mb-card"]);
+    if let Some(class) = level_class {
+        card.add_css_class(class);
+    }
+
+    // Title row with optional LOW/CRITICAL badge.
+    let title_row = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    let title = gtk::Label::new(None);
+    title.add_css_class("mb-card-title");
+    title.set_xalign(0.0);
+    title.set_hexpand(true);
+    title.set_markup(&format!(
+        "<span letter_spacing=\"1024\">{}</span>",
+        esc(&provider.window_title(window).to_uppercase())
+    ));
+    title_row.append(&title);
+    if let Some(class) = level_class {
+        let badge = gtk::Label::new(Some(if level == Level::Danger {
+            "CRITICAL"
+        } else {
+            "LOW"
+        }));
+        badge.set_css_classes(&["mb-card-badge", class]);
+        badge.set_valign(gtk::Align::Center);
+        title_row.append(&badge);
+    }
+    card.append(&title_row);
+
+    // Big "80% remaining" line.
+    let number_color = match level {
+        Level::Ok => TEXT,
+        level => level_hex(level, spec.accent),
+    };
+    let value = gtk::Label::new(None);
+    value.set_xalign(0.0);
+    value.set_markup(&format!(
+        "<span font=\"JetBrains Mono 27\" weight=\"600\" foreground=\"{number_color}\">{pct:.0}</span><span font=\"JetBrains Mono 14\" foreground=\"{DIM}\">%</span><span font=\"9.5\" foreground=\"{FAINT}\"> remaining</span>",
+    ));
+    card.append(&value);
+
+    card.append(&build_segment_bar(pct, level_rgb(level, spec.accent_rgb)));
+
+    // Reset countdown row.
+    let reset_row = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    match window.reset_time() {
+        Some(resets_at) => {
+            let countdown = gtk::Label::new(None);
+            countdown.add_css_class("mb-reset");
+            countdown.set_xalign(0.0);
+            countdown.set_hexpand(true);
+            let epoch = resets_at.timestamp();
+            set_countdown_markup(&countdown, epoch - Utc::now().timestamp());
+            reset_row.append(&countdown);
+            countdowns.push((countdown, epoch));
+
+            let absolute = gtk::Label::new(None);
+            absolute.add_css_class("mb-reset");
+            absolute.set_markup(&format!(
+                "<span foreground=\"{FAINT}\">{}</span>",
+                esc(&fmt_reset_abs(resets_at))
+            ));
+            reset_row.append(&absolute);
+        }
+        None => {
+            let unavailable = gtk::Label::new(None);
+            unavailable.add_css_class("mb-reset");
+            unavailable.set_xalign(0.0);
+            unavailable.set_hexpand(true);
+            unavailable.set_markup(&format!(
+                "<span foreground=\"{FAINT}\">reset time unavailable</span>"
+            ));
+            reset_row.append(&unavailable);
+        }
+    }
+    card.append(&reset_row);
+    card
+}
+
+fn set_countdown_markup(label: &gtk::Label, secs_left: i64) {
+    label.set_markup(&format!(
+        "<span foreground=\"{DIM}\">resets in </span><span foreground=\"{TEXT}\">{}</span>",
+        esc(&fmt_countdown(secs_left))
+    ));
+}
