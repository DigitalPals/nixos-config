index 0000000..d599193
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/modelbar_data.rs
@@ -0,0 +1,350 @@
+use std::{env, path::PathBuf, process::Stdio, time::Duration};
+
+use chrono::{DateTime, Local, Utc};
+use serde::Deserialize;
+use tokio::{process::Command, time::timeout};
+use wayle_config::schemas::modules::ModelbarConfig;
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(20);
+
+/// Bridge invocation settings resolved from the modelbar module config.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct BridgeSettings {
+    pub(crate) command: String,
+    pub(crate) claude_bin: String,
+    pub(crate) codex_bin: String,
+}
+
+impl BridgeSettings {
+    pub(crate) fn from_config(config: &ModelbarConfig) -> Self {
+        Self {
+            command: config.command.get(),
+            claude_bin: config.claude_bin.get(),
+            codex_bin: config.codex_bin.get(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub(crate) struct ModelbarStatus {
+    pub(crate) text: String,
+    #[serde(default)]
+    pub(crate) class: String,
+}
+
+impl ModelbarStatus {
+    pub(crate) fn offline(error: &str) -> Self {
+        tracing::warn!(error, "modelbar status unavailable");
+        Self {
+            text: String::from("Models offline"),
+            class: String::from("offline"),
+        }
+    }
+}
+
+pub(crate) async fn fetch_status(settings: BridgeSettings) -> ModelbarStatus {
+    match timeout(
+        COMMAND_TIMEOUT,
+        run_command::<ModelbarStatus>("status", settings),
+    )
+    .await
+    {
+        Ok(Ok(status)) => status,
+        Ok(Err(error)) => ModelbarStatus::offline(&error),
+        Err(_) => ModelbarStatus::offline("timed out while fetching ModelBar usage"),
+    }
+}
+
+/// Full structured usage payload used by the dropdown UI.
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct ModelbarPayload {
+    pub(crate) ok: bool,
+    pub(crate) updated_at: Option<String>,
+    pub(crate) providers: Vec<ProviderData>,
+    pub(crate) error: Option<String>,
+}
+
+impl ModelbarPayload {
+    pub(crate) fn provider(&self, id: &str) -> Option<&ProviderData> {
+        self.providers.iter().find(|p| p.provider == id)
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct ProviderData {
+    pub(crate) ok: bool,
+    pub(crate) provider: String,
+    pub(crate) source: Option<String>,
+    pub(crate) usage: Option<UsageData>,
+    pub(crate) credits: Option<CreditsData>,
+    pub(crate) account: Option<AccountData>,
+    pub(crate) error: Option<String>,
+}
+
+impl ProviderData {
+    pub(crate) fn windows(&self) -> Vec<WindowData> {
+        let Some(usage) = &self.usage else {
+            return Vec::new();
+        };
+        let mut windows = Vec::new();
+        for window in [&usage.primary, &usage.secondary, &usage.tertiary]
+            .into_iter()
+            .flatten()
+        {
+            windows.push(window.clone());
+        }
+        if let Some(extra) = &usage.extra_rate_windows {
+            windows.extend(extra.iter().cloned());
+        }
+        windows
+    }
+
+    pub(crate) fn min_remaining(&self) -> Option<f64> {
+        self.windows()
+            .iter()
+            .map(WindowData::remaining)
+            .fold(None, |acc: Option<f64>, pct| {
+                Some(acc.map_or(pct, |current| current.min(pct)))
+            })
+    }
+
+    /// "Claude Max 5x · claude-oauth" style meta line.
+    pub(crate) fn subtitle(&self) -> String {
+        let mut parts = Vec::new();
+        if let Some(account) = &self.account {
+            if let Some(plan) = account.plan.as_ref().filter(|value| !value.is_empty()) {
+                parts.push(plan.clone());
+            }
+            if let Some(email) = account.email.as_ref().filter(|value| !value.is_empty()) {
+                parts.push(email.clone());
+            }
+        }
+        if let Some(source) = self.source.as_ref().filter(|value| !value.is_empty()) {
+            parts.push(source.clone());
+        }
+        parts.join(" · ")
+    }
+
+    pub(crate) fn window_title(&self, window: &WindowData) -> String {
+        let label = window.label.as_deref().unwrap_or("Usage");
+        match (self.provider.as_str(), window.window_minutes) {
+            ("codex", Some(300)) | ("claude", Some(300)) => "5 hour limit".to_owned(),
+            ("codex", Some(10080)) => "Weekly limit".to_owned(),
+            ("claude", Some(10080)) if label.eq_ignore_ascii_case("weekly") => {
+                "Weekly limit".to_owned()
+            }
+            _ => label.to_owned(),
+        }
+    }
+
+    /// Optional credits card as (title, value, detail).
+    pub(crate) fn credit_card(&self) -> Option<(String, String, String)> {
+        let credits = self.credits.as_ref()?;
+        if credits.unlimited.unwrap_or(false) {
+            return Some((
+                "Credits remaining".to_owned(),
+                "Unlimited".to_owned(),
+                "No credit cap reported".to_owned(),
+            ));
+        }
+        if let (Some(used), Some(limit)) = (credits.used, credits.limit)
+            && used >= 0.0
+            && limit >= 0.0
+        {
+            let currency = credits.currency.as_deref();
+            return Some((
+                credits
+                    .period
+                    .clone()
+                    .filter(|value| !value.is_empty())
+                    .unwrap_or_else(|| "Credits".to_owned()),
+                format!(
+                    "{} / {}",
+                    format_money(used, currency),
+                    format_money(limit, currency)
+                ),
+                "Extra usage".to_owned(),
+            ));
+        }
+        let remaining = credits.remaining?;
+        if remaining >= 0.0 {
+            return Some((
+                "Credits remaining".to_owned(),
+                if remaining.fract() == 0.0 {
+                    format!("{remaining:.0}")
+                } else {
+                    format!("{remaining:.2}")
+                },
+                "Use credits to continue beyond your plan limits".to_owned(),
+            ));
+        }
+        None
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct UsageData {
+    pub(crate) primary: Option<WindowData>,
+    pub(crate) secondary: Option<WindowData>,
+    pub(crate) tertiary: Option<WindowData>,
+    pub(crate) extra_rate_windows: Option<Vec<WindowData>>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct WindowData {
+    pub(crate) label: Option<String>,
+    pub(crate) used_percent: f64,
+    pub(crate) remaining_percent: Option<f64>,
+    pub(crate) window_minutes: Option<u64>,
+    pub(crate) resets_at: Option<String>,
+}
+
+impl WindowData {
+    pub(crate) fn remaining(&self) -> f64 {
+        self.remaining_percent
+            .unwrap_or(100.0 - self.used_percent)
+            .clamp(0.0, 100.0)
+    }
+
+    pub(crate) fn reset_time(&self) -> Option<DateTime<Utc>> {
+        self.resets_at
+            .as_deref()
+            .and_then(|value| DateTime::parse_from_rfc3339(value).ok())
+            .map(|dt| dt.with_timezone(&Utc))
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct CreditsData {
+    pub(crate) remaining: Option<f64>,
+    pub(crate) used: Option<f64>,
+    pub(crate) limit: Option<f64>,
+    pub(crate) currency: Option<String>,
+    pub(crate) unlimited: Option<bool>,
+    pub(crate) period: Option<String>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct AccountData {
+    pub(crate) email: Option<String>,
+    pub(crate) plan: Option<String>,
+}
+
+pub(crate) async fn fetch_payload(settings: BridgeSettings) -> Result<ModelbarPayload, String> {
+    match timeout(
+        COMMAND_TIMEOUT,
+        run_command::<ModelbarPayload>("payload", settings),
+    )
+    .await
+    {
+        Ok(result) => result,
+        Err(_) => Err("Timed out while fetching ModelBar usage.".to_owned()),
+    }
+}
+
+async fn run_command<T: serde::de::DeserializeOwned>(
+    arg: &str,
+    settings: BridgeSettings,
+) -> Result<T, String> {
+    let binary = command_path(&settings);
+    let mut command = Command::new(&binary);
+    command
+        .arg(arg)
+        .stdin(Stdio::null())
+        .stderr(Stdio::piped())
+        .stdout(Stdio::piped());
+    if !settings.claude_bin.is_empty() {
+        command.env("MODELBAR_CLAUDE_BIN", &settings.claude_bin);
+    }
+    if !settings.codex_bin.is_empty() {
+        command.env("MODELBAR_CODEX_BIN", &settings.codex_bin);
+    }
+    let output = command
+        .output()
+        .await
+        .map_err(|err| format!("failed to run {}: {err}", binary.display()))?;
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    serde_json::from_str::<T>(&stdout).map_err(|err| {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        format!("invalid ModelBar JSON: {err}; {}", stderr.trim())
+    })
+}
+
+fn command_path(settings: &BridgeSettings) -> PathBuf {
+    let configured = settings.command.trim();
+    if !configured.is_empty() {
+        return expand_home(configured);
+    }
+    if let Some(path) = env::var_os("WAYLE_MODELBAR_BIN") {
+        return PathBuf::from(path);
+    }
+    let home = env::var_os("HOME").unwrap_or_else(|| "/home/john".into());
+    PathBuf::from(home)
+        .join(".config")
+        .join("wayle")
+        .join("bin")
+        .join("wayle-model-usage")
+}
+
+fn expand_home(path: &str) -> PathBuf {
+    if let Some(rest) = path.strip_prefix("~/")
+        && let Some(home) = env::var_os("HOME")
+    {
+        return PathBuf::from(home).join(rest);
+    }
+    PathBuf::from(path)
+}
+
+pub(crate) fn format_local_time(value: &str) -> String {
+    DateTime::parse_from_rfc3339(value)
+        .map(|dt| dt.with_timezone(&Local).format("%-I:%M:%S %p").to_string())
+        .unwrap_or_else(|_| "just now".to_owned())
+}
+
+pub(crate) fn fmt_countdown(secs: i64) -> String {
+    if secs <= 0 {
+        return "now".to_owned();
+    }
+    let days = secs / 86400;
+    let hours = (secs % 86400) / 3600;
+    let minutes = (secs % 3600) / 60;
+    let seconds = secs % 60;
+    if days > 0 {
+        format!("{days}d {hours:02}h")
+    } else if hours > 0 {
+        format!("{hours}h {minutes:02}m")
+    } else {
+        format!("{minutes}:{seconds:02}")
+    }
+}
+
+pub(crate) fn fmt_reset_abs(resets_at: DateTime<Utc>) -> String {
+    let local = resets_at.with_timezone(&Local);
+    if local.date_naive() == Local::now().date_naive() {
+        local.format("%-I:%M %p").to_string()
+    } else {
+        local.format("%b %-d %-I:%M %p").to_string()
+    }
+}
+
+fn format_money(value: f64, currency: Option<&str>) -> String {
+    let amount = if value.abs() >= 1000.0 {
+        format!("{:.1}K", value / 1000.0)
+    } else {
+        format!("{value:.2}")
+    };
+    match currency.unwrap_or("").to_uppercase().as_str() {
+        "USD" => format!("${amount}"),
+        "EUR" => format!("EUR {amount}"),
+        "GBP" => format!("GBP {amount}"),
+        code if !code.is_empty() => format!("{amount} {code}"),
+        _ => amount,
+    }
+}
