+use relm4::prelude::*;
+
+use super::ModelbarDropdown;
+use crate::shell::{
+    bar::dropdowns::{DropdownFactory, DropdownInstance},
+    services::ShellServices,
+};
+
+pub(crate) struct Factory;
+
+impl DropdownFactory for Factory {
+    fn create(_services: &ShellServices) -> Option<DropdownInstance> {
+        let controller = ModelbarDropdown::builder().launch(()).detach();
+
+        let popover = controller.widget().clone();
+        Some(DropdownInstance::new(popover, Box::new(controller)))
+    }
+}
diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/modelbar/mod.rs b/crates/wayle-shell/src/shell/bar/dropdowns/modelbar/mod.rs
new file mode 100644
index 0000000..efe5e82
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/modelbar/mod.rs
@@ -0,0 +1,221 @@
+mod factory;
+
+use gtk::{pango, prelude::*};
+use relm4::{gtk, prelude::*};
+use wayle_widgets::prelude::*;
+
+pub(super) use self::factory::Factory;
+use crate::shell::{
+    bar::{
+        dropdowns::scaled_dimension,
+        modelbar_data::{ModelbarStatus, fetch_status},
+    },
+    helpers::COMPONENT_CSS_PRIORITY,
+};
+
+const BASE_WIDTH: f32 = 420.0;
+const BASE_HEIGHT: f32 = 520.0;
+
+pub(crate) struct ModelbarDropdown {
+    status: ModelbarStatus,
+    scaled_width: i32,
+    scaled_height: i32,
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelbarDropdownMsg {
+    Refresh,
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelbarDropdownCmd {
+    StatusLoaded(ModelbarStatus),
+}
+
+#[relm4::component(pub(crate))]
+impl Component for ModelbarDropdown {
+    type Init = ();
+    type Input = ModelbarDropdownMsg;
+    type Output = ();
+    type CommandOutput = ModelbarDropdownCmd;
+
+    view! {
+        #[root]
+        gtk::Popover {
+            set_css_classes: &["dropdown", "modelbar-dropdown"],
+            set_has_arrow: false,
+            set_width_request: model.scaled_width,
+            set_height_request: model.scaled_height,
+
+            #[template]
+            Dropdown {
+                set_width_request: model.scaled_width,
+
+                #[template]
+                DropdownHeader {
+                    #[template_child]
+                    icon {
+                        set_visible: true,
+                        set_icon_name: Some("ld-brain-symbolic"),
+                    },
+                    #[template_child]
+                    label {
+                        set_label: "ModelBar",
+                    },
+                    #[template_child]
+                    actions {
+                        #[template]
+                        GhostIconButton {
+                            set_icon_name: "tb-refresh-symbolic",
+                            set_tooltip_text: Some("Refresh usage"),
+                            connect_clicked => ModelbarDropdownMsg::Refresh,
+                        },
+                    },
+                },
+
+                #[template]
+                DropdownContent {
+                    set_vexpand: true,
+
+                    gtk::Box {
+                        add_css_class: "modelbar-summary",
+                        set_orientation: gtk::Orientation::Vertical,
+                        set_spacing: 8,
+
+                        gtk::Label {
+                            add_css_class: "modelbar-title",
+                            set_xalign: 0.0,
+                            set_ellipsize: pango::EllipsizeMode::End,
+                            #[watch]
+                            set_label: &model.status.text,
+                        },
+
+                        gtk::LevelBar {
+                            add_css_class: "modelbar-level",
+                            set_min_value: 0.0,
+                            set_max_value: 100.0,
+                            #[watch]
+                            set_value: model.status.percentage as f64,
+                        },
+                    },
+
+                    gtk::ScrolledWindow {
+                        add_css_class: "modelbar-scroll",
+                        set_vexpand: true,
+                        set_policy: (gtk::PolicyType::Never, gtk::PolicyType::Automatic),
+
+                        gtk::Box {
+                            add_css_class: "modelbar-details",
+                            set_orientation: gtk::Orientation::Vertical,
+                            set_spacing: 6,
+
+                            #[watch]
+                            set_visible: !model.status.tooltip_lines().is_empty(),
+
+                            #[watch]
+                            set_margin_top: 8,
+
+                            #[watch]
+                            set_tooltip_text: Some(&model.status.tooltip),
+
+                            #[watch]
+                            set_css_classes: &["modelbar-details", &model.status.class],
+
+                            gtk::Label {
+                                add_css_class: "modelbar-detail-text",
+                                set_xalign: 0.0,
+                                set_yalign: 0.0,
+                                set_wrap: true,
+                                set_selectable: true,
+                                #[watch]
+                                set_label: &model.status.tooltip,
+                            },
+                        },
+                    },
+                },
+            },
+        }
+    }
+
+    fn init(
+        _init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let scale = 1.0;
+        let model = Self {
+            status: ModelbarStatus::offline("Loading ModelBar usage..."),
+            scaled_width: scaled_dimension(BASE_WIDTH, scale),
+            scaled_height: scaled_dimension(BASE_HEIGHT, scale),
+        };
+        sender.oneshot_command(async { ModelbarDropdownCmd::StatusLoaded(fetch_status().await) });
+        load_css();
+        let widgets = view_output!();
+
+        ComponentParts { model, widgets }
+    }
+
+    fn update(&mut self, msg: Self::Input, sender: ComponentSender<Self>, _root: &Self::Root) {
+        match msg {
+            ModelbarDropdownMsg::Refresh => {
+                sender.oneshot_command(async {
+                    ModelbarDropdownCmd::StatusLoaded(fetch_status().await)
+                });
+            }
+        }
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        _sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        match msg {
+            ModelbarDropdownCmd::StatusLoaded(status) => {
+                self.status = status;
+            }
+        }
+    }
+}
+
+fn load_css() {
+    let provider = gtk::CssProvider::new();
+    provider.load_from_string(
+        r#"
+        .modelbar-dropdown .modelbar-summary {
+            padding: 12px;
+            border-radius: 8px;
+            background: alpha(currentColor, 0.05);
+        }
+        .modelbar-dropdown .modelbar-title {
+            font-weight: 600;
+        }
+        .modelbar-dropdown .modelbar-detail-text {
+            font-family: monospace;
+            font-size: 0.88em;
+            line-height: 1.3;
+        }
+        .modelbar.ok .bar-button label,
+        .modelbar-dropdown .ok {
+            color: #46b576;
+        }
+        .modelbar.warning .bar-button label,
+        .modelbar-dropdown .warning {
+            color: #e0a93e;
+        }
+        .modelbar.critical .bar-button label,
+        .modelbar-dropdown .critical {
+            color: #e2604f;
+        }
+        .modelbar.offline .bar-button label,
+        .modelbar-dropdown .offline {
+            opacity: 0.72;
+        }
+        "#,
+    );
+
+    if let Some(display) = gtk::gdk::Display::default() {
+        gtk::style_context_add_provider_for_display(&display, &provider, COMPONENT_CSS_PRIORITY);
+    }
+}
