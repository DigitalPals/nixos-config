@@ -0,0 +1,17 @@
+use std::time::Duration;
+
+use relm4::ComponentSender;
+use tokio::time::interval;
+use tokio_stream::wrappers::IntervalStream;
+use wayle_widgets::watch;
+
+use super::{ModelbarCmd, ModelbarModule};
+
+const REFRESH_INTERVAL: Duration = Duration::from_secs(300);
+
+pub(super) fn spawn_watchers(sender: &ComponentSender<ModelbarModule>) {
+    let interval_stream = IntervalStream::new(interval(REFRESH_INTERVAL));
+    watch!(sender, [interval_stream], |out| {
+        let _ = out.send(ModelbarCmd::Refresh);
+    });
+}
