+
+pub(crate) struct ModelbarInit {
+    pub(crate) settings: BarSettings,
+    pub(crate) dropdowns: Rc<DropdownRegistry>,
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelbarMsg {
+    LeftClick,
+    RightClick,
+    MiddleClick,
+    ScrollUp,
+    ScrollDown,
+}
