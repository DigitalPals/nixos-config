+use std::{env, path::PathBuf, process::Stdio, time::Duration};
+
+use chrono::{DateTime, Local, Utc};
+use serde::Deserialize;
+use tokio::{process::Command, time::timeout};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(20);
+
+#[derive(Clone, Debug, Deserialize)]
+pub(crate) struct ModelbarStatus {
+    pub(crate) text: String,
+    pub(crate) tooltip: String,
+    #[serde(default)]
+    pub(crate) class: String,
+}
+
+impl ModelbarStatus {
+    pub(crate) fn offline(error: impl Into<String>) -> Self {
+        Self {
+            text: String::from("Models offline"),
+            tooltip: error.into(),
+            class: String::from("offline"),
+        }
+    }
+}
+
+pub(crate) async fn fetch_status() -> ModelbarStatus {
+    match timeout(COMMAND_TIMEOUT, run_command::<ModelbarStatus>("status")).await {
+        Ok(Ok(status)) => status,
+        Ok(Err(error)) => ModelbarStatus::offline(error),
+        Err(_) => ModelbarStatus::offline("Timed out while fetching ModelBar usage."),
+    }
+}
+
+/// Full structured usage payload used by the dropdown UI.
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct ModelbarPayload {
+    pub(crate) ok: bool,
+    pub(crate) updated_at: Option<String>,
+    pub(crate) providers: Vec<ProviderData>,
+    pub(crate) error: Option<String>,
+}
+
+impl ModelbarPayload {
+    pub(crate) fn provider(&self, id: &str) -> Option<&ProviderData> {
+        self.providers.iter().find(|p| p.provider == id)
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct ProviderData {
+    pub(crate) ok: bool,
+    pub(crate) provider: String,
+    pub(crate) source: Option<String>,
+    pub(crate) usage: Option<UsageData>,
+    pub(crate) credits: Option<CreditsData>,
+    pub(crate) account: Option<AccountData>,
+    pub(crate) local: Option<LocalData>,
+    pub(crate) error: Option<String>,
+}
+
+impl ProviderData {
+    pub(crate) fn windows(&self) -> Vec<WindowData> {
+        let Some(usage) = &self.usage else {
+            return Vec::new();
+        };
+        let mut windows = Vec::new();
+        for window in [&usage.primary, &usage.secondary, &usage.tertiary]
+            .into_iter()
+            .flatten()
+        {
+            windows.push(window.clone());
+        }
+        if let Some(extra) = &usage.extra_rate_windows {
+            windows.extend(extra.iter().cloned());
+        }
+        windows
+    }
+
+    pub(crate) fn min_remaining(&self) -> Option<f64> {
+        self.windows()
+            .iter()
+            .map(WindowData::remaining)
+            .fold(None, |acc: Option<f64>, pct| {
+                Some(acc.map_or(pct, |current| current.min(pct)))
+            })
+    }
+
+    /// "Claude Max 5x · claude-oauth" style meta line.
+    pub(crate) fn subtitle(&self) -> String {
+        let mut parts = Vec::new();
+        if let Some(account) = &self.account {
+            if let Some(plan) = account.plan.as_ref().filter(|value| !value.is_empty()) {
+                parts.push(plan.clone());
+            }
+            if let Some(email) = account.email.as_ref().filter(|value| !value.is_empty()) {
+                parts.push(email.clone());
+            }
+        }
+        if let Some(source) = self.source.as_ref().filter(|value| !value.is_empty()) {
+            parts.push(source.clone());
+        }
+        parts.join(" · ")
+    }
+
+    pub(crate) fn window_title(&self, window: &WindowData) -> String {
+        let label = window.label.as_deref().unwrap_or("Usage");
+        match (self.provider.as_str(), window.window_minutes) {
+            ("codex", Some(300)) | ("claude", Some(300)) => "5 hour limit".to_owned(),
+            ("codex", Some(10080)) => "Weekly limit".to_owned(),
+            ("claude", Some(10080)) if label.eq_ignore_ascii_case("weekly") => {
+                "Weekly limit".to_owned()
+            }
+            _ => label.to_owned(),
+        }
+    }
+
+    /// Optional credits card as (title, value, detail).
+    pub(crate) fn credit_card(&self) -> Option<(String, String, String)> {
+        let credits = self.credits.as_ref()?;
+        if credits.unlimited.unwrap_or(false) {
+            return Some((
+                "Credits remaining".to_owned(),
+                "Unlimited".to_owned(),
+                "No credit cap reported".to_owned(),
+            ));
+        }
+        if let (Some(used), Some(limit)) = (credits.used, credits.limit)
+            && used >= 0.0
+            && limit >= 0.0
+        {
+            let currency = credits.currency.as_deref();
+            return Some((
+                credits
+                    .period
+                    .clone()
+                    .filter(|value| !value.is_empty())
+                    .unwrap_or_else(|| "Credits".to_owned()),
+                format!(
+                    "{} / {}",
+                    format_money(used, currency),
+                    format_money(limit, currency)
+                ),
+                "Extra usage".to_owned(),
+            ));
+        }
+        let remaining = credits.remaining?;
+        if remaining >= 0.0 {
+            return Some((
+                "Credits remaining".to_owned(),
+                if remaining.fract() == 0.0 {
+                    format!("{remaining:.0}")
+                } else {
+                    format!("{remaining:.2}")
+                },
+                "Use credits to continue beyond your plan limits".to_owned(),
+            ));
+        }
+        None
+    }
+}
