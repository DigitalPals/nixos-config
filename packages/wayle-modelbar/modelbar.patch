+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct UsageData {
+    pub(crate) primary: Option<WindowData>,
+    pub(crate) secondary: Option<WindowData>,
+    pub(crate) tertiary: Option<WindowData>,
+    pub(crate) extra_rate_windows: Option<Vec<WindowData>>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct WindowData {
+    pub(crate) label: Option<String>,
+    pub(crate) used_percent: f64,
+    pub(crate) remaining_percent: Option<f64>,
+    pub(crate) window_minutes: Option<u64>,
+    pub(crate) resets_at: Option<String>,
+}
+
+impl WindowData {
+    pub(crate) fn remaining(&self) -> f64 {
+        self.remaining_percent
+            .unwrap_or(100.0 - self.used_percent)
+            .clamp(0.0, 100.0)
+    }
+
+    pub(crate) fn reset_time(&self) -> Option<DateTime<Utc>> {
+        self.resets_at
+            .as_deref()
+            .and_then(|value| DateTime::parse_from_rfc3339(value).ok())
+            .map(|dt| dt.with_timezone(&Utc))
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct CreditsData {
+    pub(crate) remaining: Option<f64>,
+    pub(crate) used: Option<f64>,
+    pub(crate) limit: Option<f64>,
+    pub(crate) currency: Option<String>,
+    pub(crate) unlimited: Option<bool>,
+    pub(crate) period: Option<String>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct AccountData {
+    pub(crate) email: Option<String>,
+    pub(crate) plan: Option<String>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub(crate) struct LocalData {
+    pub(crate) prompts_today: Option<u64>,
+    pub(crate) sessions_today: Option<u64>,
+    pub(crate) latest_session_tokens: Option<u64>,
+    pub(crate) latest_model: Option<String>,
+}
+
+pub(crate) async fn fetch_payload() -> Result<ModelbarPayload, String> {
+    match timeout(COMMAND_TIMEOUT, run_command::<ModelbarPayload>("payload")).await {
+        Ok(result) => result,
+        Err(_) => Err("Timed out while fetching ModelBar usage.".to_owned()),
+    }
+}
+
+async fn run_command<T: serde::de::DeserializeOwned>(arg: &str) -> Result<T, String> {
+    let binary = command_path();
+    let output = Command::new(&binary)
+        .arg(arg)
+        .stdin(Stdio::null())
+        .stderr(Stdio::piped())
+        .stdout(Stdio::piped())
+        .output()
+        .await
+        .map_err(|err| format!("failed to run {}: {err}", binary.display()))?;
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    serde_json::from_str::<T>(&stdout).map_err(|err| {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        format!("invalid ModelBar JSON: {err}; {}", stderr.trim())
+    })
+}
+
+fn command_path() -> PathBuf {
+    if let Some(path) = env::var_os("WAYLE_MODELBAR_BIN") {
+        return PathBuf::from(path);
+    }
+    let home = env::var_os("HOME").unwrap_or_else(|| "/home/john".into());
+    PathBuf::from(home)
+        .join(".config")
+        .join("wayle")
+        .join("bin")
+        .join("wayle-model-usage")
+}
+
+pub(crate) fn format_local_time(value: &str) -> String {
+    DateTime::parse_from_rfc3339(value)
+        .map(|dt| dt.with_timezone(&Local).format("%-I:%M:%S %p").to_string())
+        .unwrap_or_else(|_| "just now".to_owned())
+}
+
+pub(crate) fn fmt_countdown(secs: i64) -> String {
+    if secs <= 0 {
+        return "now".to_owned();
+    }
+    let days = secs / 86400;
+    let hours = (secs % 86400) / 3600;
+    let minutes = (secs % 3600) / 60;
+    let seconds = secs % 60;
+    if days > 0 {
+        format!("{days}d {hours:02}h")
+    } else if hours > 0 {
+        format!("{hours}h {minutes:02}m")
+    } else {
+        format!("{minutes}:{seconds:02}")
+    }
+}
+
+pub(crate) fn fmt_reset_abs(resets_at: DateTime<Utc>) -> String {
+    let local = resets_at.with_timezone(&Local);
+    if local.date_naive() == Local::now().date_naive() {
+        local.format("%-I:%M %p").to_string()
+    } else {
+        local.format("%b %-d %-I:%M %p").to_string()
+    }
+}
+
+pub(crate) fn format_compact_u64(value: u64) -> String {
+    if value >= 1_000_000 {
+        format!("{:.1}M", value as f64 / 1_000_000.0)
+    } else if value >= 1_000 {
+        format!("{:.1}K", value as f64 / 1_000.0)
+    } else {
+        value.to_string()
+    }
+}
+
+fn format_money(value: f64, currency: Option<&str>) -> String {
+    let amount = if value.abs() >= 1000.0 {
+        format!("{:.1}K", value / 1000.0)
+    } else {
+        format!("{value:.2}")
+    };
+    match currency.unwrap_or("").to_uppercase().as_str() {
+        "USD" => format!("${amount}"),
+        "EUR" => format!("EUR {amount}"),
+        "GBP" => format!("GBP {amount}"),
+        code if !code.is_empty() => format!("{amount} {code}"),
+        _ => amount,
+    }
+}
