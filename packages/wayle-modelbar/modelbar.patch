+fn build_local_stats(provider: &ProviderData) -> Option<gtk::Box> {
+    let local = provider.local.as_ref()?;
+    let stats = [
+        ("prompts today", local.prompts_today.map(|v| v.to_string())),
+        (
+            "sessions today",
+            local.sessions_today.map(|v| v.to_string()),
+        ),
+        (
+            "latest tokens",
+            local.latest_session_tokens.map(format_compact_u64),
+        ),
+        (
+            "latest model",
+            local.latest_model.clone().filter(|s| !s.is_empty()),
+        ),
+    ];
+    if stats.iter().all(|(_, value)| value.is_none()) {
+        return None;
+    }
+
+    let section = gtk::Box::new(gtk::Orientation::Vertical, 8);
+    let header = gtk::Label::new(None);
+    header.add_css_class("mb-card-title");
+    header.set_xalign(0.0);
+    header.set_markup("<span letter_spacing=\"1024\">LOCAL ACTIVITY</span>");
+    section.append(&header);
+
+    let chips = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    for (label, value) in stats {
+        let Some(value) = value else { continue };
+        let chip = gtk::Box::new(gtk::Orientation::Vertical, 2);
+        chip.set_css_classes(&["mb-chip"]);
+
+        let caption = gtk::Label::new(Some(label));
+        caption.add_css_class("mb-chip-label");
+        caption.set_xalign(0.0);
+        chip.append(&caption);
+
+        let amount = gtk::Label::new(Some(&value));
+        amount.add_css_class("mb-chip-value");
+        amount.set_xalign(0.0);
+        chip.append(&amount);
+        chips.append(&chip);
+    }
+    section.append(&chips);
+    Some(section)
+}
+
+fn build_notice(title: &str, body: &str, accent: &str) -> gtk::Box {
+    let card = gtk::Box::new(gtk::Orientation::Vertical, 4);
+    card.set_css_classes(&["mb-card", "mb-notice"]);
+
+    let title_label = gtk::Label::new(None);
+    title_label.set_xalign(0.0);
+    title_label.set_markup(&format!(
+        "<span weight=\"600\" foreground=\"{accent}\">{}</span>",
+        esc(title)
+    ));
+    card.append(&title_label);
+
+    let body_label = gtk::Label::new(None);
+    body_label.set_xalign(0.0);
+    body_label.set_wrap(true);
+    body_label.set_markup(&format!("<span foreground=\"{DIM}\">{}</span>", esc(body)));
+    card.append(&body_label);
+    card
+}
+
+fn unavailable_notice(provider: &ProviderData) -> (String, String) {
+    let raw_error = provider
+        .error
+        .as_deref()
+        .unwrap_or("The provider did not return usage data.");
+
+    let normalized = raw_error.to_lowercase();
+    let needs_claude_auth = provider.provider == "claude"
+        && (normalized == "unauthorized"
+            || normalized.contains("no claude oauth credentials")
+            || normalized.contains("no claude access token")
+            || normalized.contains("run `claude` to authenticate"));
+    if needs_claude_auth {
+        return (
+            "Claude authorization required".to_owned(),
+            format!(
+                "Run `claude` in a terminal once, finish the Claude login/status prompts, then press Refresh. Details: {raw_error}"
+            ),
+        );
+    }
+
+    ("Usage unavailable".to_owned(), raw_error.to_owned())
+}
