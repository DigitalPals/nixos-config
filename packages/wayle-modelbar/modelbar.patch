@@ -0,0 +1,987 @@
+mod factory;
+
+use std::time::Instant;
+
+use chrono::Utc;
+use gtk::{glib, prelude::*};
+use relm4::{gtk, prelude::*};
+
+pub(super) use self::factory::Factory;
+use crate::shell::{
+    bar::{
+        dropdowns::scaled_dimension,
+        modelbar_data::{
+            ModelbarPayload, ProviderData, WindowData, fetch_payload, fmt_countdown,
+            fmt_reset_abs, format_compact_u64, format_local_time,
+        },
+    },
+    helpers::COMPONENT_CSS_PRIORITY,
+};
+
+const BASE_WIDTH: f32 = 560.0;
+const BASE_HEIGHT: f32 = 540.0;
+const REFRESH_INTERVAL_SECS: u64 = 300;
+/// Reopening the dropdown within this window keeps the cached data.
+const REOPEN_FETCH_SECS: u64 = 30;
+const BAR_SEGMENTS: i32 = 30;
+
+const TEXT: &str = "#e8ecf1";
+const DIM: &str = "#8b95a3";
+const FAINT: &str = "#5b6470";
+const WARN: &str = "#e0a93e";
+const DANGER: &str = "#e2604f";
+const OK_GREEN: &str = "#46b576";
+const INSET_RGB: (f64, f64, f64) = (0.051, 0.067, 0.082);
+const BORDER_RGB: (f64, f64, f64) = (0.137, 0.169, 0.208);
+
+struct ProviderSpec {
+    id: &'static str,
+    name: &'static str,
+    tool: &'static str,
+    accent: &'static str,
+    accent_rgb: (f64, f64, f64),
+    dot_class: &'static str,
+}
+
+const PROVIDERS: [ProviderSpec; 2] = [
+    ProviderSpec {
+        id: "claude",
+        name: "Claude",
+        tool: "Claude Code",
+        accent: "#d97757",
+        accent_rgb: (0.851, 0.467, 0.341),
+        dot_class: "claude",
+    },
+    ProviderSpec {
+        id: "codex",
+        name: "Codex",
+        tool: "Codex CLI",
+        accent: "#4fb8a8",
+        accent_rgb: (0.310, 0.722, 0.659),
+        dot_class: "codex",
+    },
+];
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Level {
+    Ok,
+    Warn,
+    Danger,
+}
+
+fn pct_level(pct: f64) -> Level {
+    if pct <= 10.0 {
+        Level::Danger
+    } else if pct <= 25.0 {
+        Level::Warn
+    } else {
+        Level::Ok
+    }
+}
+
+fn level_hex(level: Level, accent: &'static str) -> &'static str {
+    match level {
+        Level::Ok => accent,
+        Level::Warn => WARN,
+        Level::Danger => DANGER,
+    }
+}
+
+fn level_rgb(level: Level, accent: (f64, f64, f64)) -> (f64, f64, f64) {
+    match level {
+        Level::Ok => accent,
+        Level::Warn => (0.878, 0.663, 0.243),
+        Level::Danger => (0.886, 0.376, 0.310),
+    }
+}
+
+fn esc(text: &str) -> glib::GString {
+    glib::markup_escape_text(text)
+}
+
+pub(crate) struct ModelbarDropdown {
+    payload: Option<ModelbarPayload>,
+    error: Option<String>,
+    active: usize,
+    busy: bool,
+    last_fetch: Option<Instant>,
+    updated_text: String,
+}
+
+struct TabUi {
+    button: gtk::Button,
+    pct: gtk::Label,
+}
+
+pub(crate) struct ModelbarUi {
+    tabs: Vec<TabUi>,
+    refresh: gtk::Button,
+    tool: gtk::Label,
+    meta: gtk::Label,
+    live_dot: gtk::Box,
+    live_label: gtk::Label,
+    cards: gtk::Box,
+    updated: gtk::Label,
+    next_poll: gtk::Label,
+    countdowns: Vec<(gtk::Label, i64)>,
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelbarDropdownMsg {
+    Refresh,
+    SelectTab(usize),
+    Opened(bool),
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelbarDropdownCmd {
+    Loaded(Result<ModelbarPayload, String>),
+    Tick,
+}
+
+impl Component for ModelbarDropdown {
+    type Init = f32;
+    type Input = ModelbarDropdownMsg;
+    type Output = ();
+    type CommandOutput = ModelbarDropdownCmd;
+    type Root = gtk::Popover;
+    type Widgets = ModelbarUi;
+
+    fn init_root() -> Self::Root {
+        let popover = gtk::Popover::new();
+        popover.set_css_classes(&["dropdown", "modelbar-dropdown"]);
+        popover.set_has_arrow(false);
+        popover
+    }
+
+    fn init(
+        scale: Self::Init,
+        root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        load_css();
+        root.set_width_request(scaled_dimension(BASE_WIDTH, scale));
+        root.set_height_request(scaled_dimension(BASE_HEIGHT, scale));
+
+        let outer = gtk::Box::new(gtk::Orientation::Vertical, 0);
+        outer.add_css_class("mb-root");
+
+        // Header: provider tab switcher + refresh.
+        let header = gtk::Box::new(gtk::Orientation::Horizontal, 0);
+        header.add_css_class("mb-header");
+
+        let tabs_box = gtk::Box::new(gtk::Orientation::Horizontal, 4);
+        tabs_box.add_css_class("mb-tabs");
+        tabs_box.set_halign(gtk::Align::Start);
+        tabs_box.set_valign(gtk::Align::Center);
+
+        let mut tabs = Vec::new();
+        for (index, spec) in PROVIDERS.iter().enumerate() {
+            let tab = build_tab(spec, index, &sender);
+            tabs_box.append(&tab.button);
+            tabs.push(tab);
+        }
+        header.append(&tabs_box);
+
+        let header_spacer = gtk::Box::new(gtk::Orientation::Horizontal, 0);
+        header_spacer.set_hexpand(true);
+        header.append(&header_spacer);
+
+        let refresh = gtk::Button::from_icon_name("tb-refresh-symbolic");
+        refresh.add_css_class("mb-refresh");
+        refresh.set_valign(gtk::Align::Center);
+        refresh.set_tooltip_text(Some("Refresh usage"));
+        let refresh_sender = sender.input_sender().clone();
+        refresh.connect_clicked(move |_| refresh_sender.emit(ModelbarDropdownMsg::Refresh));
+        header.append(&refresh);
+        outer.append(&header);
+
+        // Body: provider meta row + scrollable cards.
+        let body = gtk::Box::new(gtk::Orientation::Vertical, 0);
+        body.add_css_class("mb-body");
+        body.set_vexpand(true);
+
+        let provider_row = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+        provider_row.add_css_class("mb-provider-row");
+
+        let tool = gtk::Label::new(None);
+        tool.add_css_class("mb-tool");
+        tool.set_xalign(0.0);
+        provider_row.append(&tool);
+
+        let meta = gtk::Label::new(None);
+        meta.add_css_class("mb-meta");
+        meta.set_xalign(0.0);
+        meta.set_ellipsize(gtk::pango::EllipsizeMode::End);
+        meta.set_hexpand(true);
+        provider_row.append(&meta);
+
+        let live_dot = gtk::Box::new(gtk::Orientation::Horizontal, 0);
+        live_dot.add_css_class("mb-live-dot");
+        live_dot.set_size_request(7, 7);
+        live_dot.set_valign(gtk::Align::Center);
+        provider_row.append(&live_dot);
+
+        let live_label = gtk::Label::new(None);
+        live_label.add_css_class("mb-live");
+        provider_row.append(&live_label);
+        body.append(&provider_row);
+
+        let cards = gtk::Box::new(gtk::Orientation::Vertical, 12);
+        cards.add_css_class("mb-cards");
+
+        let scroll = gtk::ScrolledWindow::new();
+        scroll.set_vexpand(true);
+        scroll.set_policy(gtk::PolicyType::Never, gtk::PolicyType::Automatic);
+        scroll.set_child(Some(&cards));
+        body.append(&scroll);
+        outer.append(&body);
+
+        // Footer: updated time + next poll countdown.
+        let footer = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+        footer.add_css_class("mb-footer");
+
+        let updated = gtk::Label::new(None);
+        updated.add_css_class("mb-foot");
+        updated.set_xalign(0.0);
+        updated.set_hexpand(true);
+        footer.append(&updated);
+
+        let next_poll = gtk::Label::new(None);
+        next_poll.add_css_class("mb-foot");
+        footer.append(&next_poll);
+        outer.append(&footer);
+
+        root.set_child(Some(&outer));
+
+        let visibility_sender = sender.input_sender().clone();
+        root.connect_visible_notify(move |popover| {
+            visibility_sender.emit(ModelbarDropdownMsg::Opened(popover.is_visible()));
+        });
+
+        // 1s tick drives countdowns, the next-poll label, and auto-refresh.
+        sender.command(|out, shutdown| {
+            shutdown
+                .register(async move {
+                    let mut interval = tokio::time::interval(std::time::Duration::from_secs(1));
+                    loop {
+                        interval.tick().await;
+                        if out.send(ModelbarDropdownCmd::Tick).is_err() {
+                            break;
+                        }
+                    }
+                })
+                .drop_on_shutdown()
+        });
+
+        let mut model = Self {
+            payload: None,
+            error: None,
+            active: 0,
+            busy: false,
+            last_fetch: None,
+            updated_text: String::from("never"),
+        };
+        model.start_refresh(&sender);
+
+        let mut widgets = ModelbarUi {
+            tabs,
+            refresh,
+            tool,
+            meta,
+            live_dot,
+            live_label,
+            cards,
+            updated,
+            next_poll,
+            countdowns: Vec::new(),
+        };
+        model.render(&mut widgets);
+
+        ComponentParts { model, widgets }
+    }
+
+    fn update_with_view(
+        &mut self,
+        widgets: &mut Self::Widgets,
+        message: Self::Input,
+        sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        match message {
+            ModelbarDropdownMsg::Refresh => {
+                self.start_refresh(&sender);
+                self.render(widgets);
+            }
+            ModelbarDropdownMsg::SelectTab(index) => {
+                if self.active != index {
+                    self.active = index;
+                    self.render(widgets);
+                }
+            }
+            ModelbarDropdownMsg::Opened(visible) => {
+                let stale = self
+                    .last_fetch
+                    .map(|at| at.elapsed().as_secs() >= REOPEN_FETCH_SECS)
+                    .unwrap_or(true);
+                if visible && stale {
+                    self.start_refresh(&sender);
+                    self.render(widgets);
+                }
+            }
+        }
+    }
+
+    fn update_cmd_with_view(
+        &mut self,
+        widgets: &mut Self::Widgets,
+        message: Self::CommandOutput,
+        sender: ComponentSender<Self>,
+        root: &Self::Root,
+    ) {
+        match message {
+            ModelbarDropdownCmd::Loaded(result) => {
+                self.busy = false;
+                match result {
+                    Ok(payload) => {
+                        self.error = payload.error.clone();
+                        self.updated_text = payload
+                            .updated_at
+                            .as_deref()
+                            .map(format_local_time)
+                            .unwrap_or_else(|| {
+                                chrono::Local::now().format("%-I:%M:%S %p").to_string()
+                            });
+                        self.payload = Some(payload);
+                    }
+                    Err(error) => self.error = Some(error),
+                }
+                self.render(widgets);
+            }
+            ModelbarDropdownCmd::Tick => {
+                if root.is_visible() {
+                    let now = Utc::now().timestamp();
+                    for (label, resets_at) in &widgets.countdowns {
+                        set_countdown_markup(label, *resets_at - now);
+                    }
+                    widgets.next_poll.set_markup(&self.next_poll_markup());
+                    if !self.busy
+                        && self
+                            .last_fetch
+                            .map(|at| at.elapsed().as_secs() >= REFRESH_INTERVAL_SECS)
+                            .unwrap_or(false)
+                    {
+                        self.start_refresh(&sender);
+                        self.render(widgets);
+                    }
+                }
+            }
+        }
+    }
+}
+
+impl ModelbarDropdown {
+    fn start_refresh(&mut self, sender: &ComponentSender<Self>) {
+        if self.busy {
+            return;
+        }
+        self.busy = true;
+        self.last_fetch = Some(Instant::now());
+        sender.oneshot_command(async { ModelbarDropdownCmd::Loaded(fetch_payload().await) });
+    }
+
+    fn provider(&self, index: usize) -> Option<&ProviderData> {
+        self.payload
+            .as_ref()
+            .and_then(|payload| payload.provider(PROVIDERS[index].id))
+    }
+
+    fn next_poll_markup(&self) -> String {
+        let value = if self.busy {
+            String::from("polling...")
+        } else {
+            let elapsed = self
+                .last_fetch
+                .map(|at| at.elapsed().as_secs())
+                .unwrap_or(REFRESH_INTERVAL_SECS);
+            format!("{}s", REFRESH_INTERVAL_SECS.saturating_sub(elapsed))
+        };
+        format!(
+            "<span foreground=\"{FAINT}\">next poll </span><span foreground=\"{DIM}\">{}</span>",
+            esc(&value)
+        )
+    }
+
+    /// Full rebuild of all data-driven widgets.
+    fn render(&self, ui: &mut ModelbarUi) {
+        // Tabs.
+        for (index, tab) in ui.tabs.iter().enumerate() {
+            let spec = &PROVIDERS[index];
+            let provider = self.provider(index);
+            if index == self.active {
+                tab.button.add_css_class("active");
+            } else {
+                tab.button.remove_css_class("active");
+            }
+            let badge = match provider {
+                Some(p) if !p.ok => format!("<span foreground=\"{DANGER}\">ERR</span>"),
+                Some(p) => match p.min_remaining() {
+                    Some(pct) => {
+                        let color = match pct_level(pct) {
+                            Level::Ok => DIM,
+                            level => level_hex(level, spec.accent),
+                        };
+                        format!("<span foreground=\"{color}\">{pct:.0}%</span>")
+                    }
+                    None => format!("<span foreground=\"{DIM}\">--</span>"),
+                },
+                None => format!("<span foreground=\"{DIM}\">--</span>"),
+            };
+            tab.pct.set_markup(&badge);
+        }
+
+        // Provider meta row.
+        let spec = &PROVIDERS[self.active];
+        let provider = self.provider(self.active);
+        ui.tool.set_label(spec.tool);
+        let subtitle = provider.map(ProviderData::subtitle).unwrap_or_default();
+        ui.meta.set_visible(!subtitle.is_empty());
+        ui.meta.set_label(&subtitle);
+
+        let ok = provider.map(|p| p.ok).unwrap_or(false);
+        ui.live_dot
+            .set_css_classes(&["mb-live-dot", if ok { "ok" } else { "err" }]);
+        ui.live_label
+            .set_css_classes(&["mb-live", if ok { "ok" } else { "err" }]);
+        ui.live_label.set_label(if ok { "LIVE" } else { "ERROR" });
+
+        // Cards.
+        ui.countdowns.clear();
+        while let Some(child) = ui.cards.first_child() {
+            ui.cards.remove(&child);
+        }
+        match provider {
+            Some(provider) => {
+                if !provider.ok {
+                    let (title, body) = unavailable_notice(provider);
+                    ui.cards.append(&build_notice(&title, &body, DANGER));
+                }
+                let windows = provider.windows();
+                if windows.is_empty() && provider.ok {
+                    ui.cards.append(&build_notice(
+                        "No usage windows",
+                        "The CLI credentials were found, but no live limit windows were returned.",
+                        DIM,
+                    ));
+                }
+
+                let grid = gtk::Grid::new();
+                grid.set_column_homogeneous(true);
+                grid.set_column_spacing(12);
+                grid.set_row_spacing(12);
+                let mut cell = 0_i32;
+                for window in &windows {
+                    let card = build_window_card(provider, window, spec, &mut ui.countdowns);
+                    grid.attach(&card, cell % 2, cell / 2, 1, 1);
+                    cell += 1;
+                }
+                if let Some((title, value, detail)) = provider.credit_card() {
+                    grid.attach(
+                        &build_credit_card(&title, &value, &detail),
+                        cell % 2,
+                        cell / 2,
+                        1,
+                        1,
+                    );
+                    cell += 1;
+                }
+                if cell > 0 {
+                    ui.cards.append(&grid);
+                }
+
+                if let Some(local) = build_local_stats(provider) {
+                    ui.cards.append(&local);
+                }
+            }
+            None if self.busy => ui.cards.append(&build_notice(
+                "Fetching usage",
+                "Reading local CLI credentials and requesting live limit windows.",
+                OK_GREEN,
+            )),
+            None => ui.cards.append(&build_notice(
+                "No usage data",
+                self.error
+                    .as_deref()
+                    .unwrap_or("Usage has not been fetched yet."),
+                DANGER,
+            )),
+        }
+
+        // Footer.
+        ui.updated.set_markup(&format!(
+            "<span foreground=\"{FAINT}\">updated </span><span foreground=\"{DIM}\">{}</span>",
+            esc(&self.updated_text)
+        ));
+        ui.next_poll.set_markup(&self.next_poll_markup());
+        ui.refresh.set_sensitive(!self.busy);
+    }
+}
+
+fn build_tab(
+    spec: &'static ProviderSpec,
+    index: usize,
+    sender: &ComponentSender<ModelbarDropdown>,
+) -> TabUi {
+    let button = gtk::Button::new();
+    button.set_css_classes(&["mb-tab"]);
+
+    let row = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    let dot = gtk::Box::new(gtk::Orientation::Horizontal, 0);
+    dot.set_css_classes(&["mb-dot", spec.dot_class]);
+    dot.set_size_request(8, 8);
+    dot.set_valign(gtk::Align::Center);
+    row.append(&dot);
+
+    let name = gtk::Label::new(Some(spec.name));
+    name.add_css_class("mb-tab-name");
+    row.append(&name);
+
+    let pct = gtk::Label::new(None);
+    pct.add_css_class("mb-tab-pct");
+    row.append(&pct);
+
+    button.set_child(Some(&row));
+    let tab_sender = sender.input_sender().clone();
+    button.connect_clicked(move |_| tab_sender.emit(ModelbarDropdownMsg::SelectTab(index)));
+
+    TabUi { button, pct }
+}
+
+fn build_window_card(
+    provider: &ProviderData,
+    window: &WindowData,
+    spec: &ProviderSpec,
+    countdowns: &mut Vec<(gtk::Label, i64)>,
+) -> gtk::Box {
+    let pct = window.remaining();
+    let level = pct_level(pct);
+    let level_class = match level {
+        Level::Ok => None,
+        Level::Warn => Some("warn"),
+        Level::Danger => Some("danger"),
+    };
+
+    let card = gtk::Box::new(gtk::Orientation::Vertical, 12);
+    card.set_css_classes(&["mb-card"]);
+    if let Some(class) = level_class {
+        card.add_css_class(class);
+    }
+
+    // Title row with optional LOW/CRITICAL badge.
+    let title_row = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    let title = gtk::Label::new(None);
+    title.add_css_class("mb-card-title");
+    title.set_xalign(0.0);
+    title.set_hexpand(true);
+    title.set_markup(&format!(
+        "<span letter_spacing=\"1024\">{}</span>",
+        esc(&provider.window_title(window).to_uppercase())
+    ));
+    title_row.append(&title);
+    if let Some(class) = level_class {
+        let badge = gtk::Label::new(Some(if level == Level::Danger {
+            "CRITICAL"
+        } else {
+            "LOW"
+        }));
+        badge.set_css_classes(&["mb-card-badge", class]);
+        badge.set_valign(gtk::Align::Center);
+        title_row.append(&badge);
+    }
+    card.append(&title_row);
+
+    // Big "80% remaining" line.
+    let number_color = match level {
+        Level::Ok => TEXT,
+        level => level_hex(level, spec.accent),
+    };
+    let value = gtk::Label::new(None);
+    value.set_xalign(0.0);
+    value.set_markup(&format!(
+        "<span font=\"JetBrains Mono 27\" weight=\"600\" foreground=\"{number_color}\">{pct:.0}</span><span font=\"JetBrains Mono 14\" foreground=\"{DIM}\">%</span><span font=\"9.5\" foreground=\"{FAINT}\"> remaining</span>",
+    ));
+    card.append(&value);
+
+    card.append(&build_segment_bar(pct, level_rgb(level, spec.accent_rgb)));
+
+    // Reset countdown row.
+    let reset_row = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    match window.reset_time() {
+        Some(resets_at) => {
+            let countdown = gtk::Label::new(None);
+            countdown.add_css_class("mb-reset");
+            countdown.set_xalign(0.0);
+            countdown.set_hexpand(true);
+            let epoch = resets_at.timestamp();
+            set_countdown_markup(&countdown, epoch - Utc::now().timestamp());
+            reset_row.append(&countdown);
+            countdowns.push((countdown, epoch));
+
+            let absolute = gtk::Label::new(None);
+            absolute.add_css_class("mb-reset");
+            absolute.set_markup(&format!(
+                "<span foreground=\"{FAINT}\">{}</span>",
+                esc(&fmt_reset_abs(resets_at))
+            ));
+            reset_row.append(&absolute);
+        }
+        None => {
+            let unavailable = gtk::Label::new(None);
+            unavailable.add_css_class("mb-reset");
+            unavailable.set_xalign(0.0);
+            unavailable.set_hexpand(true);
+            unavailable.set_markup(&format!(
+                "<span foreground=\"{FAINT}\">reset time unavailable</span>"
+            ));
+            reset_row.append(&unavailable);
+        }
+    }
+    card.append(&reset_row);
+    card
+}
