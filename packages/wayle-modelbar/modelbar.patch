diff --git a/crates/wayle-shell/src/shell/bar/modules/modelbar/mod.rs b/crates/wayle-shell/src/shell/bar/modules/modelbar/mod.rs
new file mode 100644
index 0000000..edcfbff
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/modules/modelbar/mod.rs
@@ -0,0 +1,146 @@
+mod factory;
+mod messages;
+mod watchers;
+
+use std::{rc::Rc, sync::Arc};
+
+use gtk::prelude::*;
+use relm4::prelude::*;
+use wayle_config::{ConfigProperty, ConfigService, schemas::styling::CssToken};
+use wayle_widgets::prelude::{
+    BarButton, BarButtonBehavior, BarButtonColors, BarButtonInit, BarButtonInput, BarButtonOutput,
+};
+
+pub(crate) use self::{
+    factory::Factory,
+    messages::{ModelbarCmd, ModelbarInit, ModelbarMsg},
+};
+use crate::shell::bar::{
+    dropdowns::{self, DropdownRegistry},
+    modelbar_data::{BridgeSettings, ModelbarStatus, fetch_status},
+};
+
+pub(crate) struct ModelbarModule {
+    bar_button: Controller<BarButton>,
+    config: Arc<ConfigService>,
+    dropdowns: Rc<DropdownRegistry>,
+    dynamic_class: Option<String>,
+}
+
+#[relm4::component(pub(crate))]
+impl Component for ModelbarModule {
+    type Init = ModelbarInit;
+    type Input = ModelbarMsg;
+    type Output = ();
+    type CommandOutput = ModelbarCmd;
+
+    view! {
+        gtk::Box {
+            add_css_class: "modelbar",
+
+            #[local_ref]
+            bar_button -> gtk::MenuButton {},
+        }
+    }
+
+    fn init(
+        init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let modelbar_config = init.config.config().modules.modelbar.clone();
+
+        let bar_button = BarButton::builder()
+            .launch(BarButtonInit {
+                icon: modelbar_config.icon_name.get(),
+                label: String::from("Models --"),
+                tooltip: None,
+                colors: BarButtonColors {
+                    icon_color: modelbar_config.icon_color.clone(),
+                    label_color: modelbar_config.label_color.clone(),
+                    icon_background: modelbar_config.icon_bg_color.clone(),
+                    button_background: modelbar_config.button_bg_color.clone(),
+                    border_color: modelbar_config.border_color.clone(),
+                    auto_icon_color: CssToken::Accent,
+                },
+                behavior: BarButtonBehavior {
+                    label_max_chars: modelbar_config.label_max_length.clone(),
+                    show_icon: modelbar_config.icon_show.clone(),
+                    show_label: modelbar_config.label_show.clone(),
+                    show_border: modelbar_config.border_show.clone(),
+                    visible: ConfigProperty::new(true),
+                },
+                settings: init.settings,
+            })
+            .forward(sender.input_sender(), |output| match output {
+                BarButtonOutput::LeftClick => ModelbarMsg::LeftClick,
+                BarButtonOutput::RightClick => ModelbarMsg::RightClick,
+                BarButtonOutput::MiddleClick => ModelbarMsg::MiddleClick,
+                BarButtonOutput::ScrollUp => ModelbarMsg::ScrollUp,
+                BarButtonOutput::ScrollDown => ModelbarMsg::ScrollDown,
+            });
+
+        watchers::spawn_watchers(&sender, modelbar_config.refresh_interval_seconds.clone());
+        let settings = BridgeSettings::from_config(&modelbar_config);
+        sender
+            .oneshot_command(async move { ModelbarCmd::StatusLoaded(fetch_status(settings).await) });
+
+        let model = Self {
+            bar_button,
+            config: init.config,
+            dropdowns: init.dropdowns,
+            dynamic_class: None,
+        };
+        let bar_button = model.bar_button.widget();
+        let widgets = view_output!();
+
+        ComponentParts { model, widgets }
+    }
+
+    fn update(&mut self, msg: Self::Input, _sender: ComponentSender<Self>, _root: &Self::Root) {
+        let modelbar = &self.config.config().modules.modelbar;
+
+        let action = match msg {
+            ModelbarMsg::LeftClick => modelbar.left_click.get(),
+            ModelbarMsg::RightClick => modelbar.right_click.get(),
+            ModelbarMsg::MiddleClick => modelbar.middle_click.get(),
+            ModelbarMsg::ScrollUp => modelbar.scroll_up.get(),
+            ModelbarMsg::ScrollDown => modelbar.scroll_down.get(),
+        };
+
+        dropdowns::dispatch_click(&action, &self.dropdowns, &self.bar_button);
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        sender: ComponentSender<Self>,
+        root: &Self::Root,
+    ) {
+        match msg {
+            ModelbarCmd::Refresh => {
+                let settings = BridgeSettings::from_config(&self.config.config().modules.modelbar);
+                sender.oneshot_command(async move {
+                    ModelbarCmd::StatusLoaded(fetch_status(settings).await)
+                });
+            }
+            ModelbarCmd::StatusLoaded(status) => self.apply_status(status, root),
+        }
+    }
+}
+
+impl ModelbarModule {
+    fn apply_status(&mut self, status: ModelbarStatus, root: &gtk::Box) {
+        self.bar_button.emit(BarButtonInput::SetLabel(status.text));
+        self.bar_button
+            .emit(BarButtonInput::SetTooltip(Some(status.tooltip)));
+
+        if let Some(old_class) = self.dynamic_class.take() {
+            root.remove_css_class(&old_class);
+        }
+        if !status.class.is_empty() {
+            root.add_css_class(&status.class);
+            self.dynamic_class = Some(status.class);
+        }
+    }
+}
