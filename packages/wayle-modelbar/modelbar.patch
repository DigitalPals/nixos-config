index 0000000..02898f9
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/modelbar_data.rs
@@ -0,0 +1,74 @@
+use std::{env, path::PathBuf, process::Stdio, time::Duration};
+
+use serde::Deserialize;
+use tokio::{process::Command, time::timeout};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(20);
+
+#[derive(Clone, Debug, Deserialize)]
+pub(crate) struct ModelbarStatus {
+    pub(crate) text: String,
+    pub(crate) tooltip: String,
+    #[serde(default)]
+    pub(crate) class: String,
+    #[serde(default)]
+    pub(crate) percentage: u8,
+}
+
+impl ModelbarStatus {
+    pub(crate) fn offline(error: impl Into<String>) -> Self {
+        Self {
+            text: String::from("Models offline"),
+            tooltip: error.into(),
+            class: String::from("offline"),
+            percentage: 0,
+        }
+    }
+
+    pub(crate) fn tooltip_lines(&self) -> Vec<String> {
+        self.tooltip
+            .lines()
+            .map(str::trim_end)
+            .filter(|line| !line.is_empty())
+            .map(ToOwned::to_owned)
+            .collect()
+    }
+}
+
+pub(crate) async fn fetch_status() -> ModelbarStatus {
+    match timeout(COMMAND_TIMEOUT, run_status_command()).await {
+        Ok(Ok(status)) => status,
+        Ok(Err(error)) => ModelbarStatus::offline(error),
+        Err(_) => ModelbarStatus::offline("Timed out while fetching ModelBar usage."),
+    }
+}
+
+async fn run_status_command() -> Result<ModelbarStatus, String> {
+    let binary = command_path();
+    let output = Command::new(&binary)
+        .arg("status")
+        .stdin(Stdio::null())
+        .stderr(Stdio::piped())
+        .stdout(Stdio::piped())
+        .output()
+        .await
+        .map_err(|err| format!("failed to run {}: {err}", binary.display()))?;
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    serde_json::from_str::<ModelbarStatus>(&stdout).map_err(|err| {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        format!("invalid ModelBar JSON: {err}; {}", stderr.trim())
+    })
+}
+
+fn command_path() -> PathBuf {
+    if let Some(path) = env::var_os("WAYLE_MODELBAR_BIN") {
+        return PathBuf::from(path);
+    }
+    let home = env::var_os("HOME").unwrap_or_else(|| "/home/john".into());
+    PathBuf::from(home)
+        .join(".config")
+        .join("wayle")
+        .join("bin")
+        .join("wayle-model-usage")
+}
