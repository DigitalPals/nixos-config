@@ -0,0 +1,138 @@
+mod factory;
+mod messages;
+mod watchers;
+
+use std::rc::Rc;
+
+use gtk::prelude::*;
+use relm4::prelude::*;
+use wayle_config::{ClickAction, ConfigProperty, schemas::styling::CssToken};
+use wayle_widgets::prelude::{
+    BarButton, BarButtonBehavior, BarButtonColors, BarButtonInit, BarButtonInput, BarButtonOutput,
+    ColorValue,
+};
+
+pub(crate) use self::{
+    factory::Factory,
+    messages::{ModelbarCmd, ModelbarInit, ModelbarMsg},
+};
+use crate::shell::bar::{
+    dropdowns::{self, DropdownRegistry},
+    modelbar_data::{ModelbarStatus, fetch_status},
+};
+
+pub(crate) struct ModelbarModule {
+    bar_button: Controller<BarButton>,
+    dropdowns: Rc<DropdownRegistry>,
+    dynamic_class: Option<String>,
+}
+
+#[relm4::component(pub(crate))]
+impl Component for ModelbarModule {
+    type Init = ModelbarInit;
+    type Input = ModelbarMsg;
+    type Output = ();
+    type CommandOutput = ModelbarCmd;
+
+    view! {
+        gtk::Box {
+            add_css_class: "modelbar",
+
+            #[local_ref]
+            bar_button -> gtk::MenuButton {},
+        }
+    }
+
+    fn init(
+        init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let bar_button = BarButton::builder()
+            .launch(BarButtonInit {
+                icon: String::from("ld-brain-symbolic"),
+                label: String::from("Models --"),
+                tooltip: None,
+                colors: BarButtonColors {
+                    icon_color: ConfigProperty::new(ColorValue::Auto),
+                    label_color: ConfigProperty::new(ColorValue::Token(CssToken::FgDefault)),
+                    icon_background: ConfigProperty::new(ColorValue::Auto),
+                    button_background: ConfigProperty::new(ColorValue::Token(
+                        CssToken::BgSurfaceElevated,
+                    )),
+                    border_color: ConfigProperty::new(ColorValue::Auto),
+                    auto_icon_color: CssToken::Accent,
+                },
+                behavior: BarButtonBehavior {
+                    label_max_chars: ConfigProperty::new(32),
+                    show_icon: ConfigProperty::new(false),
+                    show_label: ConfigProperty::new(true),
+                    show_border: ConfigProperty::new(false),
+                    visible: ConfigProperty::new(true),
+                },
+                settings: init.settings,
+            })
+            .forward(sender.input_sender(), |output| match output {
+                BarButtonOutput::LeftClick => ModelbarMsg::LeftClick,
+                BarButtonOutput::RightClick => ModelbarMsg::RightClick,
+                BarButtonOutput::MiddleClick => ModelbarMsg::MiddleClick,
+                BarButtonOutput::ScrollUp => ModelbarMsg::ScrollUp,
+                BarButtonOutput::ScrollDown => ModelbarMsg::ScrollDown,
+            });
+
+        watchers::spawn_watchers(&sender);
+        sender.oneshot_command(async { ModelbarCmd::StatusLoaded(fetch_status().await) });
+
+        let model = Self {
+            bar_button,
+            dropdowns: init.dropdowns,
+            dynamic_class: None,
+        };
+        let bar_button = model.bar_button.widget();
+        let widgets = view_output!();
+
+        ComponentParts { model, widgets }
+    }
+
+    fn update(&mut self, msg: Self::Input, _sender: ComponentSender<Self>, _root: &Self::Root) {
+        let action = match msg {
+            ModelbarMsg::LeftClick => ClickAction::Dropdown(String::from("modelbar")),
+            ModelbarMsg::RightClick
+            | ModelbarMsg::MiddleClick
+            | ModelbarMsg::ScrollUp
+            | ModelbarMsg::ScrollDown => ClickAction::None,
+        };
+
+        dropdowns::dispatch_click(&action, &self.dropdowns, &self.bar_button);
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        sender: ComponentSender<Self>,
+        root: &Self::Root,
+    ) {
+        match msg {
+            ModelbarCmd::Refresh => {
+                sender.oneshot_command(async { ModelbarCmd::StatusLoaded(fetch_status().await) });
+            }
+            ModelbarCmd::StatusLoaded(status) => self.apply_status(status, root),
+        }
+    }
+}
+
+impl ModelbarModule {
+    fn apply_status(&mut self, status: ModelbarStatus, root: &gtk::Box) {
+        self.bar_button.emit(BarButtonInput::SetLabel(status.text));
+        self.bar_button
+            .emit(BarButtonInput::SetTooltip(Some(status.tooltip)));
+
+        if let Some(old_class) = self.dynamic_class.take() {
+            root.remove_css_class(&old_class);
+        }
+        if !status.class.is_empty() {
+            root.add_css_class(&status.class);
+            self.dynamic_class = Some(status.class);
+        }
+    }
+}
