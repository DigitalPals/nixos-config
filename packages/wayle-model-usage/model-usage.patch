+use std::{rc::Rc, sync::Arc};
+
+use wayle_config::ConfigService;
+use wayle_widgets::prelude::BarSettings;
+
+use crate::shell::bar::{dropdowns::DropdownRegistry, model_usage_data::ModelUsageStatus};
+
+pub(crate) struct ModelUsageInit {
+    pub(crate) settings: BarSettings,
+    pub(crate) config: Arc<ConfigService>,
+    pub(crate) dropdowns: Rc<DropdownRegistry>,
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelUsageMsg {
+    LeftClick,
+    RightClick,
+    MiddleClick,
+    ScrollUp,
+    ScrollDown,
+}
+
+#[derive(Debug)]
+pub(crate) enum ModelUsageCmd {
+    Refresh,
+    /// Delayed re-fetch scheduled after an offline status.
+    Retry,
+    StatusLoaded(ModelUsageStatus),
+}
diff --git a/crates/wayle-shell/src/shell/bar/modules/model_usage/mod.rs b/crates/wayle-shell/src/shell/bar/modules/model_usage/mod.rs
new file mode 100644
index 0000000..89692d8
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/modules/model_usage/mod.rs
@@ -0,0 +1,174 @@
+mod factory;
+mod messages;
+mod watchers;
+
+use std::{rc::Rc, sync::Arc, time::Duration};
+
+use gtk::prelude::*;
+use relm4::prelude::*;
+use wayle_config::{ClickAction, ConfigProperty, ConfigService, schemas::styling::CssToken};
+use wayle_widgets::prelude::{
+    BarButton, BarButtonBehavior, BarButtonColors, BarButtonInit, BarButtonInput, BarButtonOutput,
+};
+
+pub(crate) use self::{
+    factory::Factory,
+    messages::{ModelUsageCmd, ModelUsageInit, ModelUsageMsg},
+};
+use crate::shell::bar::{
+    dropdowns::{self, DropdownRegistry},
+    model_usage_data::{BridgeSettings, ModelUsageStatus, fetch_status},
+};
+
+/// Re-fetch this soon after an offline status instead of waiting out the
+/// full refresh interval; network blips should not pin the label to
+/// "Models offline" for minutes.
+const OFFLINE_RETRY_SECS: u64 = 30;
+
+pub(crate) struct ModelUsageModule {
+    bar_button: Controller<BarButton>,
+    config: Arc<ConfigService>,
+    dropdowns: Rc<DropdownRegistry>,
+    dynamic_class: Option<String>,
+    retry_pending: bool,
+}
+
+#[relm4::component(pub(crate))]
+impl Component for ModelUsageModule {
+    type Init = ModelUsageInit;
+    type Input = ModelUsageMsg;
+    type Output = ();
+    type CommandOutput = ModelUsageCmd;
+
+    view! {
+        gtk::Box {
+            add_css_class: "model-usage",
+
+            #[local_ref]
+            bar_button -> gtk::MenuButton {},
+        }
+    }
+
+    fn init(
+        init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let model_usage_config = init.config.config().modules.model_usage.clone();
+
+        let bar_button = BarButton::builder()
+            .launch(BarButtonInit {
+                icon: model_usage_config.icon_name.get(),
+                label: String::from("Models --"),
+                tooltip: None,
+                colors: BarButtonColors {
+                    icon_color: model_usage_config.icon_color.clone(),
+                    label_color: model_usage_config.label_color.clone(),
+                    icon_background: model_usage_config.icon_bg_color.clone(),
+                    button_background: model_usage_config.button_bg_color.clone(),
+                    border_color: model_usage_config.border_color.clone(),
+                    auto_icon_color: CssToken::Accent,
+                },
+                behavior: BarButtonBehavior {
+                    label_max_chars: model_usage_config.label_max_length.clone(),
+                    show_icon: model_usage_config.icon_show.clone(),
+                    show_label: model_usage_config.label_show.clone(),
+                    show_border: model_usage_config.border_show.clone(),
+                    visible: ConfigProperty::new(true),
+                },
+                settings: init.settings,
+            })
+            .forward(sender.input_sender(), |output| match output {
+                BarButtonOutput::LeftClick => ModelUsageMsg::LeftClick,
+                BarButtonOutput::RightClick => ModelUsageMsg::RightClick,
+                BarButtonOutput::MiddleClick => ModelUsageMsg::MiddleClick,
+                BarButtonOutput::ScrollUp => ModelUsageMsg::ScrollUp,
+                BarButtonOutput::ScrollDown => ModelUsageMsg::ScrollDown,
+            });
+
+        watchers::spawn_watchers(&sender, model_usage_config.refresh_interval_seconds.clone());
+        let settings = BridgeSettings::from_config(&model_usage_config);
+        sender.oneshot_command(
+            async move { ModelUsageCmd::StatusLoaded(fetch_status(settings).await) },
+        );
+
+        let model = Self {
+            bar_button,
+            config: init.config,
+            dropdowns: init.dropdowns,
+            dynamic_class: None,
+            retry_pending: false,
+        };
+        let bar_button = model.bar_button.widget();
+        let widgets = view_output!();
+
+        ComponentParts { model, widgets }
+    }
+
+    fn update(&mut self, msg: Self::Input, sender: ComponentSender<Self>, _root: &Self::Root) {
+        let model_usage = &self.config.config().modules.model_usage;
+
+        let action = match msg {
+            ModelUsageMsg::LeftClick => model_usage.left_click.get(),
+            ModelUsageMsg::RightClick => model_usage.right_click.get(),
+            ModelUsageMsg::MiddleClick => model_usage.middle_click.get(),
+            ModelUsageMsg::ScrollUp => model_usage.scroll_up.get(),
+            ModelUsageMsg::ScrollDown => model_usage.scroll_down.get(),
+        };
+
+        // Opening the dropdown triggers its own payload fetch; refresh the
+        // bar label too so the two never show contradicting states.
+        if matches!(action, ClickAction::Dropdown(_)) {
+            sender.oneshot_command(async { ModelUsageCmd::Refresh });
+        }
+
+        dropdowns::dispatch_click(&action, &self.dropdowns, &self.bar_button);
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        sender: ComponentSender<Self>,
+        root: &Self::Root,
+    ) {
+        match msg {
+            ModelUsageCmd::Refresh => self.fetch(&sender),
+            ModelUsageCmd::Retry => {
+                self.retry_pending = false;
+                self.fetch(&sender);
+            }
+            ModelUsageCmd::StatusLoaded(status) => {
+                let offline = status.class == "offline";
+                self.apply_status(status, root);
+                if offline && !self.retry_pending {
+                    self.retry_pending = true;
+                    sender.oneshot_command(async {
+                        tokio::time::sleep(Duration::from_secs(OFFLINE_RETRY_SECS)).await;
+                        ModelUsageCmd::Retry
+                    });
+                }
+            }
+        }
+    }
+}
+
+impl ModelUsageModule {
+    fn fetch(&self, sender: &ComponentSender<Self>) {
+        let settings = BridgeSettings::from_config(&self.config.config().modules.model_usage);
+        sender.oneshot_command(
+            async move { ModelUsageCmd::StatusLoaded(fetch_status(settings).await) },
+        );
+    }
+
+    fn apply_status(&mut self, status: ModelUsageStatus, root: &gtk::Box) {
+        self.bar_button.emit(BarButtonInput::SetLabel(status.text));
+
+        if let Some(old_class) = self.dynamic_class.take() {
+            root.remove_css_class(&old_class);
+        }
+        if !status.class.is_empty() {
+            root.add_css_class(&status.class);
+            self.dynamic_class = Some(status.class);
+        }
+    }
+}
